# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# Data: exclude large satellite/binary files (>50MB per CLAUDE.md)
# Small tabular data (CSV, Parquet) ARE committed
data/raw/**/*.nc
data/raw/**/*.h5
data/raw/**/*.hdf5
data/raw/**/*.npy
data/raw/**/*.tif
data/raw/**/*.tiff
data/raw/**/*.zip
data/raw/**/*.npz
data/raw/modis/*.csv
data/processed/**/*.nc
data/processed/**/*.h5
data/processed/**/*.npy
data/processed/**/*.tif
data/processed/**/*.npz
# Manually downloaded files stay local (user downloads these separately)
data/Manually\ Download/



# Notebook outputs
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Credentials
.env
*credentials*.json
*secret*.json
*service_account*.json
# Allow data metadata and configs
!data/**/*.json
!**/configs/*.json

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.bbl
paper/*.blg
paper/*.toc
